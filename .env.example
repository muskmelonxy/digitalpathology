# Environment variables for Digital Slide Preview System
# Copy to .env and export from systemd. Do not commit real secrets.

NODE_ENV=production
PORT=3001
JWT_SECRET=change-me

# Optional KFB decoder overrides (defaults resolve relative to the repo)
# PFB_PYTHON=/usr/bin/python3
# KFB_DLL=/path/to/libImageOperationLib.so
# KFB_BLANK=/path/to/blank_256.jpg
# KFB_LIBJPEG=/path/to/libjpeg.so.9
# KFB_TIMEOUT_MS=1800000
# KFB_CROP_CONTENT=0

# Optional: cap source page pixels for pathological TIFFs (0 = unlimited)
# SLIDE_MAX_PIXELS=0
